# Copiar a .env y completar. El .env NO se versiona.
# POSTGRES_PASSWORD y JWT_SECRET no tienen valor por defecto: si faltan, la app no arranca.

# --- Base de datos ---
POSTGRES_USER=taller
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# postgresql+asyncpg (por defecto) o postgresql+psycopg
POSTGRES_DRIVER=postgresql+asyncpg
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true para ver las consultas en la consola (evidencia del caso C-15)
SQL_ECHO=false

# --- Token ---
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=30
# true en producción, detrás de HTTPS
COOKIE_SECURE=false

# --- Contraseñas ---
BCRYPT_ROUNDS=12
BCRYPT_CONCURRENCIA=4

# --- Límite de intentos de login (RN-08) ---
LOGIN_MAX_FALLOS=5
LOGIN_VENTANA_SEGUNDOS=60
